# ============================================================================
#  Example .env for the Agentic Grand Prix run scripts.
# ============================================================================
#
#  HOW TO USE
#  ----------
#  1. Copy this file:    cp .env.example .env
#  2. Edit .env, paste your real key.
#  3. Run any of the run_*.py scripts. They will pick up the values from .env
#     automatically.
#
#  Precedence (highest wins):
#      1. Variables already set in your shell (e.g. `export MINIMAX_API_KEY=...`)
#      2. Values in this file (loaded by load_env.py)
#
#  So you can keep a long-lived default here and override per-run in the shell,
#  or vice versa.
#
#  This file is git-ignored (.gitignore lists `.env`). Never commit your real
#  key. Only `.env.example` is checked in, and it contains placeholders only.
#
# ============================================================================

# --- Provider/model selection -----------------------------------------------
# Which chat-completions API the agents should call.
# Options: ollama | anthropic | openai | minimax
RACE_LLM_PROVIDER=minimax

# The model name to send. Defaults are set by each run_*.py for the provider
# they care about; this lets you override.
#   ollama   -> hermes3 (local, free)
#   openai   -> gpt-4o-mini
#   anthropic-> claude-opus-5
#   minimax  -> MiniMax-M3
RACE_LLM_MODEL=MiniMax-M3

# --- Provider-specific config ------------------------------------------------

# Ollama (default if no provider specified): where the OpenAI-compatible server
# is listening. The default below assumes `ollama serve` is running locally.
# OLLAMA_BASE_URL=http://localhost:11434/v1

# MiniMax token-plan key. Get yours from the MiniMax console.
# Format: sk-cp-...
MINIMAX_API_KEY=***paste-your-key-here***

# Anthropic hosted key — only needed if RACE_LLM_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=***paste-your-key-here***

# OpenAI hosted key — only needed if RACE_LLM_PROVIDER=openai.
# OPENAI_API_KEY=***paste-your-key-here***
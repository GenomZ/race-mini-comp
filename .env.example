# Agentic Grand Prix - LLM settings.
#
# 1. Copy this file to .env (same folder as race.py):
#        PowerShell:  Copy-Item .env.example .env
#        macOS/Linux: cp .env.example .env
# 2. Paste the key your instructor gives you (Day 2, 09:00) after MINIMAX_API_KEY=  (no quotes, no spaces).
# 3. Check it:  uv run race.py doctor --llm     (or: python race.py doctor --llm)
#
# .env is git-ignored: NEVER commit it, never paste the key into a driver file, a notebook or a chat.
# Real environment variables always win over .env. No key yet? LLM_PROVIDER=mock works offline.

# --- provider --------------------------------------------------------------------------------------
# minimax (default) | mock (offline, no key) | replay (play back a recorded cassette)
# | openai | ollama | openrouter (backups, see the bottom of this file)
LLM_PROVIDER=minimax

# --- MiniMax ---------------------------------------------------------------------------------------
MINIMAX_API_KEY=
# International accounts (platform.minimax.io). Mainland-China accounts: https://api.minimax.cn/v1
MINIMAX_BASE_URL=https://api.minimax.io/v1

# Model - pick ONE:
#   MiniMax-M3          course default. Thinking can be switched OFF (LLM_EFFORT=none) for fast answers.
#                       Measured (warm): chat 0.47-0.57 s with thinking off, 1.1 s at effort low.
#   MiniMax-M3.1-Flash  cheaper, but ALWAYS thinks: effort low..max is sent as reasoning_effort, and
#                       "none" is sent as "low". Measured (warm): chat 1.8 s at effort low.
LLM_MODEL=MiniMax-M3

# Effort: none | low | medium | high | xhigh | max     ("off" = none). Default: low.
#   MiniMax-M3:          none = thinking disabled; any other value = the model thinks first.
#                        Tool turns (llm.ask_with_tools, the Pit Crew) KEEP thinking on even with
#                        effort none: without thinking M3 often says it called a tool instead of calling it.
#   MiniMax-M3.1-Flash:  always set it - MiniMax's own default for this model is max (slow).
#   The thinking text is kept apart from the answer: llm.last_reasoning() shows it (LLM Trace page).
LLM_EFFORT=low

# --- limits & logging (optional; defaults shown) -------------------------------------------------------
# LLM_TIMEOUT=30            # seconds per request (default 30; inside plan()/reflect(): 120, official races: 60)
# LLM_MAX_RETRIES=2         # retries on timeouts / server errors (fatal MiniMax errors stop at once)
# LLM_DAILY_CAP=250         # soft per-process call cap; prints "llm calls 47/250"
# LLM_MAX_RPM=6             # client-side requests/minute limit (default: off)
# LLM_MAX_INFLIGHT=1        # requests in flight per process
# LLM_LOG_DIR=logs/llm      # append every request/response as JSONL
# LLM_CACHE_DIR=.cache/llm  # where chat(..., cache=True) stores answers
# LLM_QUIET=1               # hide the "[llm] llm calls n/cap" line

# --- record / replay (offline demos) -----------------------------------------------------------------
# LLM_RECORD=races/demo/cassette.jsonl      # record real responses while using a real provider
# LLM_CASSETTE=races/demo/cassette.jsonl    # with LLM_PROVIDER=replay: play them back, no network

# --- other providers (backup only) ---------------------------------------------------------------------
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Instructor only: password for the Race Control Inbox page (uploads). Required on a hosted server.
# AGP_INSTRUCTOR_PASSWORD=

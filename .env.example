# Copy to .env (or export) - which LLM the baseline and your agent use.
# Provider: ollama (default, local Hermes 3) | anthropic | openai | minimax
RACE_LLM_PROVIDER=ollama
RACE_LLM_MODEL=hermes3
OLLAMA_BASE_URL=http://localhost:11434/v1

# Hosted providers (only needed if you switch RACE_LLM_PROVIDER):
# ANTHROPIC_API_KEY=***        # e.g. RACE_LLM_MODEL=claude-opus-5 (planner) or claude-haiku-4-5 (fast executor)
# OPENAI_API_KEY=***
# MINIMAX_API_KEY=***          # used when RACE_LLM_PROVIDER=minimax; base URL is fixed at https://api.minimax.io/v1
